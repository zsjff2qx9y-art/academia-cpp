    class GerenciadorAcademia {
        -vector alunos
        -string arquivo
        -istream entrada
        -ostream saida
        +GerenciadorAcademia(arquivo, entrada, saida)
        +getAlunos() vector
        +inserir() void
        +listarTodos() void
        +pesquisar(string nome) int
        +exibirUm() void
        +alterar() void
        +remover() void
        +relatorio() void
        +salvar() void
        -carregar() void
    }
    Aluno <|-- AlunoMusculacao
    Aluno <|-- AlunoFuncional
    Aluno "1" *-- "1" Data : dataMatricula
    GerenciadorAcademia "1" *-- "0..*" Aluno : alunos

    note for GerenciadorAcademia "alunos: vector de unique_ptr de Aluno; entrada e saida sao referencias"
    note for Aluno "getTipo e clonar sao virtuais puros; exibir, editar e serializar sao virtuais"
