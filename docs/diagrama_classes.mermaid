classDiagram
    class Data {
        -int dia
        -int mes
        -int ano
        +Data(int dia, int mes, int ano)
        +getDia() int
        +getMes() int
        +getAno() int
        +hoje() Data
        +deISO(string texto) Data
        +toISO() string
        +toString() string
    }
    class Aluno {
        <<abstract>>
        -string nome
        -string telefone
        -long long mensalidadeCentavos
        -Data dataMatricula
        +Aluno(nome, telefone, mensalidadeCentavos, dataMatricula)
        +~Aluno()
        +getNome() string
        +getTelefone() string
        +getMensalidadeCentavos() long long
        +getDataMatricula() Data
        +getTipo() string
        +exibir(ostream saida) void
        +editar(istream entrada, ostream saida) void
        +serializar() string
        +clonar() unique_ptr
    }
